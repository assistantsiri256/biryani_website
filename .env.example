# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=https://binarypro.example.com

# ---- Database (empty = SQLite for local dev) ----
# DATABASE_URL=postgres://user:password@localhost:5432/binarypro
DATABASE_URL=

# ---- Encryption of PAN / bank / UPI (required when DEBUG=False) ----
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# ---- Redis / Celery (empty = run inline, in-memory cache) ----
# REDIS_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/0

# ---- UPI QR payments (scan & pay, admin confirms the UTR) ----
# e.g. yourbusiness@okhdfcbank  (empty = QR option hidden)
UPI_ID=
UPI_PAYEE_NAME=BinaryPro
# Top-up wallet deposit limits (₹)
DEPOSIT_MIN=100
DEPOSIT_MAX=100000

# ---- USDT (BEP-20) deposits (verified automatically on BNB Smart Chain) ----
# Your BSC wallet address (0x...). Empty = USDT option hidden.
USDT_BEP20_ADDRESS=
# Rupees credited to the top-up wallet per 1 USDT
USDT_INR_RATE=100
# BSC_RPC_URL=https://bsc-dataseed.binance.org/
# BSC_MIN_CONFIRMATIONS=15

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Demo payments are only allowed with DEBUG=True
PAYMENT_DEMO_MODE=True

# ---- Email (OTP codes are sent by email) ----
# Empty EMAIL_BACKEND = codes are printed in the server console.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters, no spaces).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=yourname@gmail.com
# EMAIL_HOST_PASSWORD=your-16-letter-app-password
# DEFAULT_FROM_EMAIL=BinaryPro <yourname@gmail.com>

# ---- SMS (not used for OTP any more) ----
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend
